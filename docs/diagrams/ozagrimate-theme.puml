' Shared look for every OzAgriMate diagram: the green and sand palette of the
' Assignment 2 context diagram. Include it after the C4 library:
'   !include ozagrimate-theme.puml
skinparam dpi 150
skinparam wrapWidth 220
skinparam defaultFontName Arial
skinparam ArrowColor #555555
skinparam ArrowFontColor #333333

UpdateElementStyle("person", $bgColor="#2F4F35", $fontColor="#FFFFFF", $borderColor="#22392A")
UpdateElementStyle("external_person", $bgColor="#7A7A7A", $fontColor="#FFFFFF", $borderColor="#5E5E5E")
UpdateElementStyle("system", $bgColor="#4A6B4F", $fontColor="#FFFFFF", $borderColor="#36513A")
UpdateElementStyle("external_system", $bgColor="#F6ECDA", $fontColor="#2B2B2B", $borderColor="#C49A3C")
UpdateElementStyle("container", $bgColor="#5E8A5F", $fontColor="#FFFFFF", $borderColor="#466B47")
UpdateElementStyle("external_container", $bgColor="#A9C2A3", $fontColor="#1F1F1F", $borderColor="#7E9C78")
UpdateElementStyle("component", $bgColor="#DCEBD2", $fontColor="#1F1F1F", $borderColor="#6B8F5E")
UpdateBoundaryStyle($bgColor="#FFFFFF", $fontColor="#2F4F35", $borderColor="#4A6B4F")
UpdateElementStyle("node", $bgColor="#FFFFFF", $fontColor="#2F4F35", $borderColor="#6B8F5E")
