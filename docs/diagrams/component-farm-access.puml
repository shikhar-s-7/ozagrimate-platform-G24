@startuml component-farm-access
!include <C4/C4_Component>
' Generated from the same model as docs/architecture/workspace.dsl; edit both together.
skinparam dpi 150
skinparam wrapWidth 220
skinparam defaultFontName Arial
SHOW_PERSON_OUTLINE()
LAYOUT_TOP_DOWN()
title Component diagram: Farm & Access Service

Container(apiGateway, "API Gateway", "NGINX", "Validates tokens, sets X-User-Id, rate-limits and routes /api/v1 calls.")
ContainerDb(accessDb, "Farm & Access DB", "PostgreSQL", "Farms, owners, agronomists and access grants.")
ContainerQueue(eventBroker, "Event Broker", "Apache Kafka", "Carries telemetry, alert, grant and recommendation events between services.")
Container(alertService, "Alert & Notification Service", "Python, FastAPI", "Checks readings against alert rules; notifies by push, then SMS.")

Container_Boundary(accessService, "Farm & Access Service [Python, FastAPI]") {
  Component(accessApi, "Access API", "FastAPI router", "Endpoints #7-8: grant and revoke an agronomist's access.")
  Component(grantManager, "Grant Manager", "Python", "Creates and revokes grants; one active grant per agronomist per farm.")
  Component(authorisationChecker, "Authorisation Checker", "Python", "Reads X-User-Id; only a farm's owner may change its grants.")
  Component(farmRegistry, "Farm Registry", "Python", "Farms, their owners and registered agronomists.")
  Component(grantEventPublisher, "Grant Event Publisher", "Kafka producer", "Publishes AccessGranted and AccessRevoked, keyed by farmId.")
}

Rel(apiGateway, accessApi, "Routes grant calls with the caller's X-User-Id", "JSON/HTTPS")
Rel(accessApi, grantManager, "Creates and revokes grants")
Rel(grantManager, authorisationChecker, "Checks the caller owns the farm")
Rel(grantManager, farmRegistry, "Looks up the farm and agronomist")
Rel(grantManager, grantEventPublisher, "Announces each grant change")
Rel(grantManager, accessDb, "Reads and writes grants", "SQL")
Rel(farmRegistry, accessDb, "Reads farms and agronomists", "SQL")
Rel(grantEventPublisher, eventBroker, "Publishes AccessGranted / AccessRevoked (key: farmId)", "Kafka")
Rel_R(alertService, eventBroker, "Consumes telemetry, grant and recommendation events; publishes AlertRaised", "Kafka")

SHOW_LEGEND(false)
@enduml
